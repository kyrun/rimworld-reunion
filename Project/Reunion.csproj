  <ItemGroup>
    <!-- Update this package version when Krafs releases the official 1.7 reference package -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.*-*" />
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
  </ItemGroup>
  
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(MSBuildLastTaskResult)' != 'false'">
    <!-- 1. Safely create the destination path if missing -->
    <MakeDir Directories="C:\Program Files (x86)\Steam\steamapps\common\RimWorld\Mods\Reunion\1.7\Assemblies" />
    
    <!-- 2. Copy the DLL, tracking if it succeeds -->
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll" 
          DestinationFolder="C:\Program Files (x86)\Steam\steamapps\common\RimWorld\Mods\Reunion\1.7\Assemblies" 
          SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="SuccessfullyCopied" />
    </Copy>
          
    <!-- 3. ONLY launch RimWorld if the file was successfully found and handled -->
    <Exec Command="start steam://rungameid/294100" 
          Condition="'@(SuccessfullyCopied)' != ''" />
  </Target>


</Project>
