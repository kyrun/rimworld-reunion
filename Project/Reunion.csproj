<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build configuration -->
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>

    <ProjectGuid>{8E264E23-3389-4DA6-836D-ABEB318EB1AE}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>Kyrun.Reunion</RootNamespace>
    <AssemblyName>Reunion</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>

    <!-- Build settings -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>


  <!-- DEBUG CONFIGURATION -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>$(MSBuildThisFileDirectory)..\Release\1.7\Assemblies\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>


  <!-- RELEASE CONFIGURATION -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>$(MSBuildThisFileDirectory)..\Release\1.7\Assemblies\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>


  <!-- NUGET DEPENDENCIES -->
  <ItemGroup>
    <!-- Automatically use the latest RimWorld 1.7 reference assemblies -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.*-*" />

    <!-- Harmony 3 reference assemblies (runtime supplied by Harmony mod) -->
    <PackageReference Include="Lib.Harmony.Ref" Version="3.*-*" />
  </ItemGroup>


  <!-- DEVELOPMENT SETTINGS -->
  <PropertyGroup>
    <!-- Default Steam installation directory -->
    <RimWorldInstallDir>C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldInstallDir>

    <!-- Automatically deploy and launch after a successful Release build -->
    <DeployToRimWorld Condition="'$(DeployToRimWorld)' == ''">true</DeployToRimWorld>
    <LaunchRimWorld Condition="'$(LaunchRimWorld)' == ''">true</LaunchRimWorld>
  </PropertyGroup>


  <!-- POST-BUILD: DEPLOY AND LAUNCH -->
  <Target Name="DeployAndLaunchRimWorld" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'">

    <PropertyGroup>
      <RimWorldInstallDir>C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldInstallDir>
      <ReunionAssembliesDirectory>$(RimWorldInstallDir)\Mods\Reunion\1.7\Assemblies</ReunionAssembliesDirectory>
    </PropertyGroup>

    <!-- Verify RimWorld installation -->
    <Error Condition="!Exists('$(RimWorldInstallDir)\RimWorld.exe')"
          Text="RimWorld installation not found at: $(RimWorldInstallDir)" />

    <!-- Verify compiled assembly -->
    <Error Condition="!Exists('$(TargetPath)')"
          Text="Build output not found: $(TargetPath)" />

    <!-- Create destination directory -->
    <MakeDir Directories="$(ReunionAssembliesDirectory)" />

    <!-- Deploy compiled assembly -->
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(ReunionAssembliesDirectory)"
          SkipUnchangedFiles="true" />

    <!-- Launch RimWorld through Steam -->
    <Exec Command="start &quot;&quot; &quot;steam://rungameid/294100&quot;" />

  </Target>

</Project>
