{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and Launch RimWorld",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "Reunion.sln",
        "-c",
        "Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}