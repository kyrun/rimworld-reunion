{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run All Tests",
      "type": "process",
      "command": "bash",
      "args": [
        "-lc",
        "dotnet build Reunion.sln -c Debug && dotnet test Tests/Reunion.Tests.csproj -c Debug && python scripts/validate_xml.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
