{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and Launch RimWorld",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "Reunion.sln",
        "-c",
        "Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run All Tests",
      "type": "process",
      "command": "C:\\Program Files\\Git\\usr\\bin\\bash.exe",
      "args": [
        "-lc",
        "dotnet build Reunion.sln -c Debug && dotnet test Tests/Reunion.Tests.csproj -c Debug && python scripts/validate_xml.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "group": "test"
    }
  ]
}